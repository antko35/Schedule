@startuml "UserManagementService - Domain"

skinparam classAttributeIconSize 0
skinparam classFontSize 13
skinparam classHeaderBackgroundColor #dce8f5
skinparam classBorderColor #4a86c8
skinparam ArrowColor #4a86c8
skinparam linetype ortho

abstract class Entity <<abstract>> {
    + Id : string
}

class Clinic {
    + ClinicName : string
    + ClinicDescription : string
    + Address : string
}

class Department {
    + DepartmentName : string
    + ClinicId : string
}

class User {
    + FirstName : string
    + LastName : string
    + Patronymic : string
    + Gender : string
    + DateOfBirth : DateOnly
    + Age : int
}

class UserJob {
    + UserId : string
    + DepartmentId : string
    + Role : string
    + Status : string
    + PhoneNumber : string
    + Email : string
}

Entity <|-- Clinic
Entity <|-- Department
Entity <|-- User
User <|-- UserJob
Department <|-- UserJob

'Department "0..*" --> "1" Clinic : принадлежит >
'UserJob "0..*" --> "1" User : относится к >
'UserJob "0..*" --> "1" Department : прикреплён к >

@enduml
