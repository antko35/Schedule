@startuml "Sequence - Schedule Generation"

skinparam sequenceArrowThickness 1.5
skinparam sequenceBoxBorderColor #4a86c8
skinparam sequenceLifeLineBorderColor #4a86c8
skinparam sequenceParticipantBorderColor #4a86c8
skinparam sequenceParticipantBackgroundColor #dce8f5
skinparam sequenceGroupBorderColor #888
skinparam sequenceGroupBackgroundColor #f5faff
skinparam noteBorderColor #c8a84a
skinparam noteBackgroundColor #fffbe6
skinparam sequenceDividerBackgroundColor #e8f0e8
skinparam sequenceDividerBorderColor #4a8c4a

actor "Hangfire / API" as Client

participant "GenerateDepartment\nScheduleHandler" as Handler
participant "UserRule\nRepository" as RuleRepo
participant "Calendar\nRepository" as CalRepo
participant "Schedule\nRepository" as SchedRepo
participant "ScheduleGenerator" as Generator

== Подготовка данных ==

Client -> Handler : Handle(departmentId, year, month)

Handler -> RuleRepo : GetUsersRulesByDepartment\n(departmentId, monthName, year)
RuleRepo --> Handler : List<UserScheduleRules>

note right of Handler
  Если список пуст —
  выбрасывается исключение
end note

par Загрузка праздников (параллельно)
    Handler -> CalRepo : GetMonthHolidays(year, month)
    CalRepo --> Handler : List<Calendar> officialHolidays
else
    Handler -> CalRepo : GetMonthTransferDays(year, month)
    CalRepo --> Handler : List<Calendar> transferDays
end

== Цикл по сотрудникам ==

loop для каждого UserScheduleRules

    Handler -> SchedRepo : ClearWorkDays(scheduleId)
    note right : Очистка старых данных\nперед генерацией

    Handler -> Generator : GenerateWorkDaysForUser\n(userRules, year, month,\nofficialHolidays, transferDays)

    == Этап 1: Генерация рабочих дней ==

    activate Generator

    loop день = 1..daysInMonth

        alt день — праздник (officialHolidays)
            Generator -> Generator : пропустить день
        else день — воскресенье
            Generator -> Generator : пропустить день
        else
            alt OnlyFirstShift
                Generator -> Generator : firstShift = true
            else OnlySecondShift
                Generator -> Generator : firstShift = false
            else EvenDOW (чётный день недели)
                Generator -> Generator : firstShift = (день недели чётный)
            else UnEvenDOW (нечётный день недели)
                Generator -> Generator : firstShift = (день недели нечётный)
            else EvenDOM (чётный день месяца)
                Generator -> Generator : firstShift = (день месяца чётный)
            else UnEvenDOM
                Generator -> Generator : firstShift = (день месяца нечётный)
            end

            Generator -> Generator : CreateWorkDay(day, firstShift)\nStartTime / EndTime (+6ч 30мин)
            note right
                1-я смена: StartWorkDayTime + 6:30
                2-я смена: 14:30 + 6:30 (фикс.)
            end note
        end

    end

    == Этап 2: Коррекция нормы часов ==

    Generator -> Generator : totalTime = count × 6.6
    alt totalTime ≠ HoursPerMonth
        Generator -> Generator : timeDiff = HoursPerMonth - totalTime\nСкорректировать EndTime\nпоследнего WorkDay
    end

    Generator --> Handler : List<WorkDay>
    deactivate Generator

    == Сохранение результата ==

    loop для каждого WorkDay
        Handler -> SchedRepo : AddWorkDayAsync(scheduleId, workDay)
    end

end

Handler --> Client : успех

@enduml
