@startuml "Domain Class Diagram"

skinparam classAttributeIconSize 0
skinparam classFontSize 13
skinparam classHeaderBackgroundColor #dce8f5
skinparam classBorderColor #4a86c8
skinparam ArrowColor #4a86c8
skinparam packageBorderColor #7aad d4
skinparam packageBackgroundColor #f5faff
skinparam linetype ortho

' ========================================================
' PACKAGE: UserManagementService
' ========================================================
package "UserManagementService.Domain" <<Rectangle>> {

    abstract class Entity <<abstract>> {
        + Id : string
    }

    class Clinic {
        + ClinicName : string
        + ClinicDescription : string
        + Address : string
    }

    class Department {
        + DepartmentName : string?
        + ClinicId : string
    }

    class User {
        + FirstName : string?
        + LastName : string?
        + Patronymic : string?
        + Gender : string?
        + DateOfBirth : DateOnly
        + Age : int
        + CalculateAge() : int
    }

    class UserJob {
        + UserId : string
        + DepartmentId : string?
        + Role : string?
        + Status : string?
        + PhoneNumber : string?
        + Email : string?
    }

    class ShortUserInfo {
        + Id : string
        + FirstName : string
        + LastName : string
        + Patronymic : string
    }

    ' Inheritance
    Entity <|-- Clinic
    Entity <|-- Department
    Entity <|-- User
    Entity <|-- UserJob

    ' Associations
    Department "many" --> "1" Clinic : ClinicId >
    UserJob "many" --> "1" User : UserId >
    UserJob "many" --> "1" Department : DepartmentId >

    ' ShortUserInfo — projection of User
    User ..> ShortUserInfo : <<проекция>>
}

' ========================================================
' PACKAGE: ScheduleService
' ========================================================
package "ScheduleService.Domain" <<Rectangle>> {

    abstract class "Entity" as SEntity <<abstract>> {
        + Id : string
    }

    class Schedule {
        + MonthName : string
        + WorkDays : List<WorkDay>
    }

    class WorkDay {
        + Day : int
        + StartTime : DateTimeOffset
        + EndTime : DateTimeOffset
    }

    class UserScheduleRules {
        + UserId : string
        + DepartmentId : string
        + MonthName : string
        + Year : int
        + HoursPerMonth : float
        + MaxHoursPerDay : float
        + StartWorkDayTime : TimeOnly
        + ScheduleId : string
        + OnlyFirstShift : bool
        + OnlySecondShift : bool
        + EvenDOW : bool
        + UnEvenDOW : bool
        + EvenDOM : bool
        + UnEvenDOM : bool
    }

    class Calendar {
        + Year : int
        + HolidayDate : DateOnly
        + TransferDate : DateOnly?
        + MonthOfHoliday : int
        + MonthOfTransferDay : int
        + HolidayDayOfMonth : int
        + DayOfWeek : DayOfWeek
    }

    ' Inheritance
    SEntity <|-- Schedule
    SEntity <|-- UserScheduleRules
    SEntity <|-- Calendar

    ' Composition: Schedule owns WorkDays
    Schedule "1" *-- "many" WorkDay : содержит >

    ' Association: UserScheduleRules -> Schedule
    UserScheduleRules "many" --> "1" Schedule : ScheduleId >
}

' ========================================================
' Cross-service references (по Id, без прямой зависимости)
' ========================================================
UserScheduleRules ..> User : UserId\n(межсервисная ссылка)
UserScheduleRules ..> Department : DepartmentId\n(межсервисная ссылка)

note bottom of UserScheduleRules
  UserId и DepartmentId хранятся как строки (ObjectId).
  Прямой зависимости между сервисами нет —
  связь реализована через события RabbitMQ.
end note

@enduml
